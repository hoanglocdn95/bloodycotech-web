    "next": "16.4.5",
    "next-mdx-remote": "^6.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-pretty-code": "^0.14.6",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@tanstack/react-query": "5.105.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "jotai": "3.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.162.0",
    "zustand": "5.0.16"
  },
  "packageManager": "pnpm@10.11.0",
  "pnpm": {
