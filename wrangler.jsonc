{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bloodycotech-web",
  "pages_build_output_dir": "./out",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bloodycotech-catalog",
      // Replace this placeholder with the id printed by `wrangler d1 create bloodycotech-catalog`.
      "database_id": "69ed210b-89cd-420b-8c40-6534f69738fa",
      "migrations_dir": "migrations",
    },
    {
      "binding": "bloodycotech_catalog",
      "database_name": "bloodycotech-catalog",
      "database_id": "69ed210b-89cd-420b-8c40-6534f69738fa",
      "remote": true,
    },
  ],
}
