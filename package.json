{
  "name": "bloodycotech",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:site": "node scripts/check-site.mjs",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run build && pnpm run check:site"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
